# ─────────────────────────────────────────────────────────────
# 복사해서 .env 로 사용하세요. .env 는 절대 커밋하지 않습니다.
# ─────────────────────────────────────────────────────────────

# [개발/데이터 파이프라인 전용] AI 허브 API 키 — 앱 배포물에 포함 금지
# 발급: https://aihub.or.kr/devsport/apishell/list.do?currMenu=403&topMenu=100
AIHUB_API_KEY=
# AIHub-MCP 빌드 결과 jar 절대경로 (.mcp.json 에서 참조)
AIHUB_MCP_JAR=

# [Speech Gateway 전용] 실시간 통역 엔진 선택
STT_PROVIDER=azure            # azure | google | clova | whisper-local
TRANSLATE_PROVIDER=papago     # papago | deepl | google | llm

# STT 엔진 키 (사용하는 것만 채움)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
GOOGLE_APPLICATION_CREDENTIALS=
CLOVA_SPEECH_SECRET=

# 번역 엔진 키 (사용하는 것만 채움)
NCP_PAPAGO_CLIENT_ID=
NCP_PAPAGO_CLIENT_SECRET=
DEEPL_API_KEY=
ANTHROPIC_API_KEY=

# 로컬 Whisper 사용 시
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda           # cuda | cpu
